[{"id":"dialogue-001","language":"korean","order":1,"title":"카페에서","titleVi":"Ở quán cà phê","category":"식당과 음식","context":"Gọi đồ uống ở quán cà phê","lines":[{"speaker":"점원","text":"어서 오세요. 뭐 드릴까요?","translation":"Mời vào. Anh dùng gì ạ?","pronunciation":"Eoseo oseyo. Mwo deurilkkayo?"},{"speaker":"남","text":"커피 한 잔 주세요.","translation":"Cho tôi một ly cà phê.","pronunciation":"Keopi han jan juseyo."},{"speaker":"점원","text":"따뜻한 거요, 차가운 거요?","translation":"Nóng hay lạnh ạ?","pronunciation":"Ttatteuthan geoyo, chagaun geoyo?"},{"speaker":"남","text":"따뜻한 커피로 주세요.","translation":"Cho tôi cà phê nóng.","pronunciation":"Ttatteuthan keopiro juseyo."},{"speaker":"점원","text":"네, 사천 원이에요.","translation":"Vâng, bốn nghìn won ạ.","pronunciation":"Ne, sacheon wonieyo."}],"vocabulary":[{"word":"커피","meaning":"Cà phê","pronunciation":"Keopi"},{"word":"잔","meaning":"Ly, cốc (đơn vị đếm)","pronunciation":"Jan"},{"word":"따뜻하다","meaning":"Ấm, nóng","pronunciation":"Ttatteuthada"},{"word":"주세요","meaning":"Cho tôi, làm ơn","pronunciation":"Juseyo"}]},{"id":"dialogue-002","language":"korean","order":2,"title":"길 묻기","titleVi":"Hỏi đường","category":"교통","context":"Hỏi đường đến ga tàu điện ngầm","lines":[{"speaker":"남","text":"실례합니다. 지하철역이 어디예요?","translation":"Xin lỗi. Ga tàu điện ngầm ở đâu ạ?","pronunciation":"Sillyehamnida. Jihacheoryeogi eodiyeyo?"},{"speaker":"행인","text":"이 길로 쭉 가세요.","translation":"Anh đi thẳng con đường này.","pronunciation":"I gillo jjuk gaseyo."},{"speaker":"남","text":"멀어요?","translation":"Có xa không ạ?","pronunciation":"Meoreoyo?"},{"speaker":"행인","text":"아니요, 가까워요. 오 분쯤 걸려요.","translation":"Không, gần thôi. Mất khoảng năm phút.","pronunciation":"Aniyo, gakkawoyo. O bunjjeum geollyeoyo."},{"speaker":"남","text":"감사합니다.","translation":"Cảm ơn ạ.","pronunciation":"Gamsahamnida."}],"vocabulary":[{"word":"지하철역","meaning":"Ga tàu điện ngầm","pronunciation":"Jihacheoryeok"},{"word":"어디","meaning":"Ở đâu","pronunciation":"Eodi"},{"word":"쭉","meaning":"Thẳng, một mạch","pronunciation":"Jjuk"},{"word":"가깝다","meaning":"Gần","pronunciation":"Gakkapda"}]},{"id":"dialogue-003","language":"korean","order":3,"title":"오랜만이에요","titleVi":"Lâu rồi mới gặp","category":"인사와 소개","context":"Hai người quen gặp lại sau lâu ngày","lines":[{"speaker":"지민","text":"어, 남 씨! 오랜만이에요.","translation":"Ồ, anh Nam! Lâu rồi mới gặp.","pronunciation":"Eo, nam ssi! Oraenmanieyo."},{"speaker":"남","text":"정말 오랜만이에요. 잘 지냈어요?","translation":"Đúng là lâu thật. Bạn khoẻ không?","pronunciation":"Jeongmal oraenmanieyo. Jal jinaesseoyo?"},{"speaker":"지민","text":"네, 잘 지냈어요. 남 씨는요?","translation":"Vâng, tôi khoẻ. Còn anh Nam?","pronunciation":"Ne, jal jinaesseoyo. Nam ssineunyo?"},{"speaker":"남","text":"저도 잘 지내요.","translation":"Tôi cũng khoẻ.","pronunciation":"Jeodo jal jinaeyo."}],"vocabulary":[{"word":"오랜만","meaning":"Lâu ngày","pronunciation":"Oraenman"},{"word":"잘 지내다","meaning":"Sống khoẻ, ổn","pronunciation":"Jal jinaeda"},{"word":"정말","meaning":"Thật sự","pronunciation":"Jeongmal"}]},{"id":"dialogue-004","language":"korean","order":4,"title":"이름이 뭐예요","titleVi":"Bạn tên gì","category":"인사와 소개","context":"Làm quen ở lớp học","lines":[{"speaker":"남","text":"안녕하세요. 이름이 뭐예요?","translation":"Xin chào. Bạn tên gì?","pronunciation":"Annyeonghaseyo. Ireumi mwoyeyo?"},{"speaker":"수진","text":"저는 수진이에요.","translation":"Tôi là Sujin.","pronunciation":"Jeoneun sujinieyo."},{"speaker":"남","text":"만나서 반가워요. 저는 남이에요.","translation":"Rất vui được gặp. Tôi là Nam.","pronunciation":"Mannaseo bangawoyo. Jeoneun namieyo."},{"speaker":"수진","text":"저도 반가워요.","translation":"Tôi cũng rất vui.","pronunciation":"Jeodo bangawoyo."}],"vocabulary":[{"word":"이름","meaning":"Tên","pronunciation":"Ireum"},{"word":"반갑다","meaning":"Vui (được gặp)","pronunciation":"Bangapda"},{"word":"저","meaning":"Tôi (khiêm nhường)","pronunciation":"Jeo"}]},{"id":"dialogue-005","language":"korean","order":5,"title":"가족을 소개해요","titleVi":"Giới thiệu gia đình","category":"인사와 소개","context":"Giới thiệu người nhà","lines":[{"speaker":"지민","text":"이분은 누구세요?","translation":"Vị này là ai vậy?","pronunciation":"Ibuneun nuguseyo?"},{"speaker":"남","text":"제 형이에요.","translation":"Anh trai tôi.","pronunciation":"Je hyeongieyo."},{"speaker":"지민","text":"아, 안녕하세요.","translation":"À, xin chào ạ.","pronunciation":"A, annyeonghaseyo."},{"speaker":"형","text":"네, 반갑습니다.","translation":"Vâng, rất hân hạnh.","pronunciation":"Ne, bangapseumnida."}],"vocabulary":[{"word":"누구","meaning":"Ai","pronunciation":"Nugu"},{"word":"형","meaning":"Anh trai","pronunciation":"Hyeong"},{"word":"반갑습니다","meaning":"Hân hạnh (trang trọng)","pronunciation":"Bangapseumnida"}]},{"id":"dialogue-006","language":"korean","order":6,"title":"명함 주고받기","titleVi":"Trao danh thiếp","category":"인사와 소개","context":"Gặp trong công việc","lines":[{"speaker":"남","text":"처음 뵙겠습니다. 제 명함이에요.","translation":"Rất hân hạnh được gặp. Đây là danh thiếp của tôi.","pronunciation":"Cheoeum boepgetseumnida. Je myeonghamieyo."},{"speaker":"부장","text":"반갑습니다. 여기 제 명함입니다.","translation":"Hân hạnh. Đây là danh thiếp của tôi.","pronunciation":"Bangapseumnida. Yeogi je myeonghamimnida."},{"speaker":"남","text":"감사합니다.","translation":"Cảm ơn ạ.","pronunciation":"Gamsahamnida."},{"speaker":"부장","text":"앞으로 잘 부탁합니다.","translation":"Mong được hợp tác tốt.","pronunciation":"Apeuro jal butakamnida."}],"vocabulary":[{"word":"처음","meaning":"Lần đầu","pronunciation":"Cheoeum"},{"word":"뵙다","meaning":"Gặp (kính ngữ)","pronunciation":"Boepda"},{"word":"명함","meaning":"Danh thiếp","pronunciation":"Myeongham"},{"word":"부탁하다","meaning":"Nhờ vả, mong","pronunciation":"Butakada"}]},{"id":"dialogue-007","language":"korean","order":7,"title":"옷 사기","titleVi":"Mua quần áo","category":"쇼핑과 서비스","context":"Mua áo ở cửa hàng","lines":[{"speaker":"남","text":"이 셔츠 있어요?","translation":"Có cái áo sơ mi này không?","pronunciation":"I syeocheu isseoyo?"},{"speaker":"점원","text":"네, 무슨 색을 원하세요?","translation":"Có, anh muốn màu gì ạ?","pronunciation":"Ne, museun saegeul wonhaseyo?"},{"speaker":"남","text":"파란색으로 주세요.","translation":"Cho tôi màu xanh.","pronunciation":"Paransaegeuro juseyo."},{"speaker":"점원","text":"여기 있습니다.","translation":"Của anh đây ạ.","pronunciation":"Yeogi itseumnida."}],"vocabulary":[{"word":"셔츠","meaning":"Áo sơ mi","pronunciation":"Syeocheu"},{"word":"색","meaning":"Màu","pronunciation":"Saek"},{"word":"파란색","meaning":"Màu xanh dương","pronunciation":"Paransaek"},{"word":"원하다","meaning":"Muốn","pronunciation":"Wonhada"}]},{"id":"dialogue-008","language":"korean","order":8,"title":"환불하기","titleVi":"Trả hàng hoàn tiền","category":"쇼핑과 서비스","context":"Đổi trả hàng","lines":[{"speaker":"남","text":"이거 환불하고 싶어요.","translation":"Tôi muốn trả lại cái này.","pronunciation":"Igeo hwanbulhago sipeoyo."},{"speaker":"점원","text":"영수증 있으세요?","translation":"Anh có hoá đơn không ạ?","pronunciation":"Yeongsujeung isseuseyo?"},{"speaker":"남","text":"네, 여기 있어요.","translation":"Có, đây ạ.","pronunciation":"Ne, yeogi isseoyo."},{"speaker":"점원","text":"환불해 드릴게요.","translation":"Tôi sẽ hoàn tiền cho anh.","pronunciation":"Hwanbulhae deurilgeyo."}],"vocabulary":[{"word":"환불","meaning":"Hoàn tiền","pronunciation":"Hwanbul"},{"word":"영수증","meaning":"Hoá đơn","pronunciation":"Yeongsujeung"},{"word":"드리다","meaning":"Đưa, làm cho (kính ngữ)","pronunciation":"Deurida"}]},{"id":"dialogue-009","language":"korean","order":9,"title":"시장에서","titleVi":"Ở chợ","category":"쇼핑과 서비스","context":"Mua rau ở chợ","lines":[{"speaker":"남","text":"이 사과 얼마예요?","translation":"Táo này bao nhiêu ạ?","pronunciation":"I sagwa eolmayeyo?"},{"speaker":"상인","text":"한 개에 천 원이에요.","translation":"Một quả một nghìn won.","pronunciation":"Han gaee cheon wonieyo."},{"speaker":"남","text":"다섯 개 주세요.","translation":"Cho tôi năm quả.","pronunciation":"Daseot gae juseyo."},{"speaker":"상인","text":"오천 원입니다.","translation":"Năm nghìn won ạ.","pronunciation":"Ocheon wonimnida."}],"vocabulary":[{"word":"시장","meaning":"Cái chợ","pronunciation":"Sijang"},{"word":"사과","meaning":"Quả táo","pronunciation":"Sagwa"},{"word":"상인","meaning":"Người bán","pronunciation":"Sangin"},{"word":"개","meaning":"Cái (đơn vị)","pronunciation":"Gae"}]},{"id":"dialogue-010","language":"korean","order":10,"title":"택배 보내기","titleVi":"Gửi bưu kiện","category":"쇼핑과 서비스","context":"Ở bưu điện","lines":[{"speaker":"남","text":"이 소포를 보내고 싶어요.","translation":"Tôi muốn gửi bưu kiện này.","pronunciation":"I soporeul bonaego sipeoyo."},{"speaker":"직원","text":"어디로 보내세요?","translation":"Anh gửi đi đâu ạ?","pronunciation":"Eodiro bonaeseyo?"},{"speaker":"남","text":"부산으로 보내요.","translation":"Gửi đi Busan.","pronunciation":"Busaneuro bonaeyo."},{"speaker":"직원","text":"삼천 원이에요.","translation":"Ba nghìn won ạ.","pronunciation":"Samcheon wonieyo."}],"vocabulary":[{"word":"소포","meaning":"Bưu kiện","pronunciation":"Sopo"},{"word":"보내다","meaning":"Gửi","pronunciation":"Bonaeda"},{"word":"직원","meaning":"Nhân viên","pronunciation":"Jigwon"},{"word":"택배","meaning":"Chuyển phát","pronunciation":"Taekbae"}]},{"id":"dialogue-011","language":"korean","order":11,"title":"메뉴 고르기","titleVi":"Chọn thực đơn","category":"식당과 음식","context":"Xem thực đơn","lines":[{"speaker":"남","text":"메뉴 좀 보여 주세요.","translation":"Cho tôi xem thực đơn.","pronunciation":"Menyu jom boyeo juseyo."},{"speaker":"점원","text":"여기 있습니다.","translation":"Của anh đây ạ.","pronunciation":"Yeogi itseumnida."},{"speaker":"남","text":"이 집은 뭐가 맛있어요?","translation":"Quán này món gì ngon ạ?","pronunciation":"I jibeun mwoga masisseoyo?"},{"speaker":"점원","text":"김치찌개가 유명해요.","translation":"Canh kim chi nổi tiếng ạ.","pronunciation":"Gimchijjigaega yumyeonghaeyo."}],"vocabulary":[{"word":"메뉴","meaning":"Thực đơn","pronunciation":"Menyu"},{"word":"보여 주다","meaning":"Cho xem","pronunciation":"Boyeo juda"},{"word":"김치찌개","meaning":"Canh kim chi","pronunciation":"Gimchijjigae"},{"word":"유명하다","meaning":"Nổi tiếng","pronunciation":"Yumyeonghada"}]},{"id":"dialogue-012","language":"korean","order":12,"title":"계산하기","titleVi":"Thanh toán","category":"식당과 음식","context":"Trả tiền sau khi ăn","lines":[{"speaker":"남","text":"계산할게요.","translation":"Cho tôi thanh toán.","pronunciation":"Gyesanhalgeyo."},{"speaker":"점원","text":"모두 만 오천 원이에요.","translation":"Tổng cộng mười lăm nghìn won.","pronunciation":"Modu man ocheon wonieyo."},{"speaker":"남","text":"카드로 할게요.","translation":"Tôi trả bằng thẻ.","pronunciation":"Kadeuro halgeyo."},{"speaker":"점원","text":"네, 여기 사인해 주세요.","translation":"Vâng, anh ký vào đây ạ.","pronunciation":"Ne, yeogi sainhae juseyo."}],"vocabulary":[{"word":"계산하다","meaning":"Thanh toán","pronunciation":"Gyesanhada"},{"word":"모두","meaning":"Tất cả, tổng cộng","pronunciation":"Modu"},{"word":"카드","meaning":"Thẻ","pronunciation":"Kadeu"},{"word":"사인","meaning":"Chữ ký","pronunciation":"Sain"}]},{"id":"dialogue-013","language":"korean","order":13,"title":"예약하기","titleVi":"Đặt bàn","category":"식당과 음식","context":"Gọi điện đặt bàn","lines":[{"speaker":"남","text":"오늘 저녁 예약하고 싶어요.","translation":"Tôi muốn đặt bàn tối nay.","pronunciation":"Oneul jeonyeok yeyakago sipeoyo."},{"speaker":"점원","text":"몇 분이세요?","translation":"Mấy người ạ?","pronunciation":"Myeot buniseyo?"},{"speaker":"남","text":"네 명이에요.","translation":"Bốn người.","pronunciation":"Ne myeongieyo."},{"speaker":"점원","text":"일곱 시에 예약되었습니다.","translation":"Đã đặt lúc bảy giờ ạ.","pronunciation":"Ilgop sie yeyakdoeeotseumnida."}],"vocabulary":[{"word":"예약","meaning":"Đặt chỗ","pronunciation":"Yeyak"},{"word":"저녁","meaning":"Buổi tối","pronunciation":"Jeonyeok"},{"word":"분","meaning":"Vị (đếm người, kính)","pronunciation":"Bun"},{"word":"되다","meaning":"Được, thành","pronunciation":"Doeda"}]},{"id":"dialogue-014","language":"korean","order":14,"title":"택시 타기","titleVi":"Đi taxi","category":"교통","context":"Gọi taxi","lines":[{"speaker":"남","text":"서울역으로 가 주세요.","translation":"Cho tôi đến ga Seoul.","pronunciation":"Seouryeogeuro ga juseyo."},{"speaker":"기사","text":"네, 알겠습니다.","translation":"Vâng, rõ ạ.","pronunciation":"Ne, algetseumnida."},{"speaker":"남","text":"얼마나 걸려요?","translation":"Mất bao lâu ạ?","pronunciation":"Eolmana geollyeoyo?"},{"speaker":"기사","text":"이십 분쯤 걸려요.","translation":"Khoảng hai mươi phút.","pronunciation":"Isip bunjjeum geollyeoyo."}],"vocabulary":[{"word":"택시","meaning":"Taxi","pronunciation":"Taeksi"},{"word":"기사","meaning":"Tài xế","pronunciation":"Gisa"},{"word":"걸리다","meaning":"Mất (thời gian)","pronunciation":"Geollida"},{"word":"알겠습니다","meaning":"Tôi hiểu rồi (kính)","pronunciation":"Algetseumnida"}]},{"id":"dialogue-015","language":"korean","order":15,"title":"지하철에서","titleVi":"Trên tàu điện ngầm","category":"교통","context":"Hỏi hướng tàu","lines":[{"speaker":"남","text":"이 지하철 강남역에 가요?","translation":"Tàu này đến ga Gangnam không ạ?","pronunciation":"I jihacheol gangnamyeoge gayo?"},{"speaker":"승객","text":"아니요, 반대 방향이에요.","translation":"Không, hướng ngược lại đấy.","pronunciation":"Aniyo, bandae banghyangieyo."},{"speaker":"남","text":"어디에서 갈아타요?","translation":"Tôi đổi tàu ở đâu ạ?","pronunciation":"Eodieseo garatayo?"},{"speaker":"승객","text":"시청역에서 갈아타세요.","translation":"Đổi ở ga Sicheong.","pronunciation":"Sicheongyeogeseo garataseyo."}],"vocabulary":[{"word":"지하철","meaning":"Tàu điện ngầm","pronunciation":"Jihacheol"},{"word":"반대","meaning":"Ngược lại","pronunciation":"Bandae"},{"word":"방향","meaning":"Hướng","pronunciation":"Banghyang"},{"word":"갈아타다","meaning":"Đổi (xe, tàu)","pronunciation":"Garatada"}]},{"id":"dialogue-016","language":"korean","order":16,"title":"기차표 사기","titleVi":"Mua vé tàu","category":"교통","context":"Mua vé ở ga","lines":[{"speaker":"남","text":"부산 가는 기차표 한 장 주세요.","translation":"Cho tôi một vé tàu đi Busan.","pronunciation":"Busan ganeun gichapyo han jang juseyo."},{"speaker":"직원","text":"몇 시 기차요?","translation":"Tàu mấy giờ ạ?","pronunciation":"Myeot si gichayo?"},{"speaker":"남","text":"오후 두 시요.","translation":"Hai giờ chiều.","pronunciation":"Ohu du siyo."},{"speaker":"직원","text":"오만 원입니다.","translation":"Năm mươi nghìn won ạ.","pronunciation":"Oman wonimnida."}],"vocabulary":[{"word":"기차표","meaning":"Vé tàu","pronunciation":"Gichapyo"},{"word":"장","meaning":"Tờ, vé (đơn vị)","pronunciation":"Jang"},{"word":"오후","meaning":"Buổi chiều","pronunciation":"Ohu"},{"word":"기차","meaning":"Tàu hoả","pronunciation":"Gicha"}]},{"id":"dialogue-017","language":"korean","order":17,"title":"출근","titleVi":"Đi làm","category":"직장과 업무","context":"Chào buổi sáng ở công ty","lines":[{"speaker":"남","text":"안녕하세요, 좋은 아침이에요.","translation":"Chào anh, buổi sáng tốt lành.","pronunciation":"Annyeonghaseyo, joeun achimieyo."},{"speaker":"동료","text":"네, 일찍 오셨네요.","translation":"Vâng, anh đến sớm nhỉ.","pronunciation":"Ne, iljjik osyeonneyo."},{"speaker":"남","text":"오늘 회의가 있어서요.","translation":"Vì hôm nay có cuộc họp.","pronunciation":"Oneul hoeuiga isseoseoyo."},{"speaker":"동료","text":"몇 시에 시작해요?","translation":"Mấy giờ bắt đầu ạ?","pronunciation":"Myeot sie sijakaeyo?"}],"vocabulary":[{"word":"출근","meaning":"Đi làm","pronunciation":"Chulgeun"},{"word":"동료","meaning":"Đồng nghiệp","pronunciation":"Dongryo"},{"word":"일찍","meaning":"Sớm","pronunciation":"Iljjik"},{"word":"회의","meaning":"Cuộc họp","pronunciation":"Hoeui"}]},{"id":"dialogue-018","language":"korean","order":18,"title":"회의 시간","titleVi":"Giờ họp","category":"직장과 업무","context":"Hẹn giờ họp","lines":[{"speaker":"부장","text":"내일 회의 몇 시가 좋아요?","translation":"Cuộc họp mai mấy giờ được?","pronunciation":"Naeil hoeui myeot siga joayo?"},{"speaker":"남","text":"오전 열 시 어떠세요?","translation":"Mười giờ sáng thế nào ạ?","pronunciation":"Ojeon yeol si eotteoseyo?"},{"speaker":"부장","text":"좋아요. 회의실에서 봐요.","translation":"Được. Gặp ở phòng họp.","pronunciation":"Joayo. Hoeuisireseo bwayo."},{"speaker":"남","text":"네, 준비하겠습니다.","translation":"Vâng, em sẽ chuẩn bị.","pronunciation":"Ne, junbihagetseumnida."}],"vocabulary":[{"word":"부장","meaning":"Trưởng phòng","pronunciation":"Bujang"},{"word":"오전","meaning":"Buổi sáng","pronunciation":"Ojeon"},{"word":"회의실","meaning":"Phòng họp","pronunciation":"Hoeuisil"},{"word":"준비하다","meaning":"Chuẩn bị","pronunciation":"Junbihada"}]},{"id":"dialogue-019","language":"korean","order":19,"title":"휴가 신청","titleVi":"Xin nghỉ phép","category":"직장과 업무","context":"Xin nghỉ với sếp","lines":[{"speaker":"남","text":"부장님, 다음 주에 휴가를 쓰고 싶어요.","translation":"Trưởng phòng, tuần sau em muốn xin nghỉ.","pronunciation":"Bujangnim, daeum jue hyugareul sseugo sipeoyo."},{"speaker":"부장","text":"며칠 쉬어요?","translation":"Nghỉ mấy ngày?","pronunciation":"Myeochil swieoyo?"},{"speaker":"남","text":"이틀이요.","translation":"Hai ngày ạ.","pronunciation":"Iteuriyo."},{"speaker":"부장","text":"알겠어요. 잘 쉬어요.","translation":"Được. Nghỉ ngơi tốt nhé.","pronunciation":"Algesseoyo. Jal swieoyo."}],"vocabulary":[{"word":"휴가","meaning":"Kỳ nghỉ phép","pronunciation":"Hyuga"},{"word":"쓰다","meaning":"Dùng, xin (nghỉ)","pronunciation":"Sseuda"},{"word":"며칠","meaning":"Mấy ngày","pronunciation":"Myeochil"},{"word":"이틀","meaning":"Hai ngày","pronunciation":"Iteul"}]},{"id":"dialogue-020","language":"korean","order":20,"title":"전화 받기","titleVi":"Nghe điện thoại","category":"직장과 업무","context":"Nhận điện thoại công ty","lines":[{"speaker":"남","text":"네, 한국회사입니다.","translation":"Vâng, công ty Hàn Quốc xin nghe.","pronunciation":"Ne, hangukoesaimnida."},{"speaker":"손님","text":"김 부장님 계세요?","translation":"Trưởng phòng Kim có đó không ạ?","pronunciation":"Gim bujangnim gyeseyo?"},{"speaker":"남","text":"잠시만 기다려 주세요.","translation":"Xin chờ một chút ạ.","pronunciation":"Jamsiman gidaryeo juseyo."},{"speaker":"손님","text":"네, 감사합니다.","translation":"Vâng, cảm ơn.","pronunciation":"Ne, gamsahamnida."}],"vocabulary":[{"word":"전화","meaning":"Điện thoại","pronunciation":"Jeonhwa"},{"word":"계시다","meaning":"Có (kính ngữ)","pronunciation":"Gyesida"},{"word":"잠시만","meaning":"Một lát","pronunciation":"Jamsiman"},{"word":"기다리다","meaning":"Chờ đợi","pronunciation":"Gidarida"}]},{"id":"dialogue-021","language":"korean","order":21,"title":"병원 접수","titleVi":"Đăng ký khám","category":"건강과 병원","context":"Đăng ký ở bệnh viện","lines":[{"speaker":"남","text":"진료 받으러 왔어요.","translation":"Tôi đến khám bệnh.","pronunciation":"Jillyo badeureo wasseoyo."},{"speaker":"간호사","text":"어디가 아프세요?","translation":"Anh đau ở đâu ạ?","pronunciation":"Eodiga apeuseyo?"},{"speaker":"남","text":"머리가 아파요.","translation":"Tôi đau đầu.","pronunciation":"Meoriga apayo."},{"speaker":"간호사","text":"잠깐 기다리세요.","translation":"Anh chờ một chút ạ.","pronunciation":"Jamkkan gidariseyo."}],"vocabulary":[{"word":"진료","meaning":"Khám bệnh","pronunciation":"Jillyo"},{"word":"아프다","meaning":"Đau","pronunciation":"Apeuda"},{"word":"머리","meaning":"Đầu","pronunciation":"Meori"},{"word":"간호사","meaning":"Y tá","pronunciation":"Ganhosa"}]},{"id":"dialogue-022","language":"korean","order":22,"title":"증상 말하기","titleVi":"Nói triệu chứng","category":"건강과 병원","context":"Khám với bác sĩ","lines":[{"speaker":"의사","text":"어떻게 오셨어요?","translation":"Anh bị làm sao ạ?","pronunciation":"Eotteoke osyeosseoyo?"},{"speaker":"남","text":"어제부터 열이 나요.","translation":"Từ hôm qua tôi bị sốt.","pronunciation":"Eojebuteo yeori nayo."},{"speaker":"의사","text":"기침도 해요?","translation":"Có ho không?","pronunciation":"Gichimdo haeyo?"},{"speaker":"남","text":"네, 기침도 나요.","translation":"Vâng, tôi cũng bị ho.","pronunciation":"Ne, gichimdo nayo."}],"vocabulary":[{"word":"의사","meaning":"Bác sĩ","pronunciation":"Uisa"},{"word":"열","meaning":"Sốt","pronunciation":"Yeol"},{"word":"나다","meaning":"Phát ra (sốt, ho)","pronunciation":"Nada"},{"word":"기침","meaning":"Ho","pronunciation":"Gichim"}]},{"id":"dialogue-023","language":"korean","order":23,"title":"약국에서","titleVi":"Ở hiệu thuốc","category":"건강과 병원","context":"Mua thuốc","lines":[{"speaker":"남","text":"감기약 주세요.","translation":"Cho tôi thuốc cảm.","pronunciation":"Gamgiyak juseyo."},{"speaker":"약사","text":"하루에 세 번 드세요.","translation":"Anh uống ngày ba lần.","pronunciation":"Harue se beon deuseyo."},{"speaker":"남","text":"식사 후에 먹어요?","translation":"Uống sau bữa ăn ạ?","pronunciation":"Siksa hue meogeoyo?"},{"speaker":"약사","text":"네, 식후에 드세요.","translation":"Vâng, uống sau khi ăn.","pronunciation":"Ne, sikue deuseyo."}],"vocabulary":[{"word":"약국","meaning":"Hiệu thuốc","pronunciation":"Yakguk"},{"word":"감기약","meaning":"Thuốc cảm","pronunciation":"Gamgiyak"},{"word":"약사","meaning":"Dược sĩ","pronunciation":"Yaksa"},{"word":"식후","meaning":"Sau bữa ăn","pronunciation":"Siku"}]},{"id":"dialogue-024","language":"korean","order":24,"title":"예약 확인","titleVi":"Xác nhận lịch hẹn","category":"건강과 병원","context":"Gọi điện xác nhận khám","lines":[{"speaker":"남","text":"내일 진료 예약을 확인하고 싶어요.","translation":"Tôi muốn xác nhận lịch khám mai.","pronunciation":"Naeil jillyo yeyageul hwaginhago sipeoyo."},{"speaker":"직원","text":"성함이 어떻게 되세요?","translation":"Anh tên gì ạ?","pronunciation":"Seonghami eotteoke doeseyo?"},{"speaker":"남","text":"남이에요.","translation":"Tôi là Nam.","pronunciation":"Namieyo."},{"speaker":"직원","text":"오후 세 시에 예약되어 있어요.","translation":"Đã hẹn lúc ba giờ chiều ạ.","pronunciation":"Ohu se sie yeyakdoeeo isseoyo."}],"vocabulary":[{"word":"확인하다","meaning":"Xác nhận","pronunciation":"Hwaginhada"},{"word":"성함","meaning":"Quý danh (kính)","pronunciation":"Seongham"},{"word":"예약","meaning":"Lịch hẹn","pronunciation":"Yeyak"},{"word":"오후","meaning":"Buổi chiều","pronunciation":"Ohu"}]},{"id":"dialogue-025","language":"korean","order":25,"title":"체크인","titleVi":"Nhận phòng","category":"여행과 호텔","context":"Nhận phòng khách sạn","lines":[{"speaker":"남","text":"체크인하고 싶어요.","translation":"Tôi muốn nhận phòng.","pronunciation":"Chekeuinhago sipeoyo."},{"speaker":"직원","text":"예약하셨어요?","translation":"Anh đã đặt phòng chưa ạ?","pronunciation":"Yeyakasyeosseoyo?"},{"speaker":"남","text":"네, 남으로 예약했어요.","translation":"Vâng, đặt tên Nam.","pronunciation":"Ne, nameuro yeyakaesseoyo."},{"speaker":"직원","text":"삼백이 호입니다.","translation":"Phòng ba trăm lẻ hai ạ.","pronunciation":"Sambaegi hoimnida."}],"vocabulary":[{"word":"체크인","meaning":"Nhận phòng","pronunciation":"Chekeuin"},{"word":"예약하다","meaning":"Đặt trước","pronunciation":"Yeyakada"},{"word":"호","meaning":"Số (phòng)","pronunciation":"Ho"},{"word":"직원","meaning":"Nhân viên","pronunciation":"Jigwon"}]},{"id":"dialogue-026","language":"korean","order":26,"title":"방 문의","titleVi":"Hỏi về phòng","category":"여행과 호텔","context":"Hỏi phòng trống","lines":[{"speaker":"남","text":"빈 방 있어요?","translation":"Còn phòng trống không ạ?","pronunciation":"Bin bang isseoyo?"},{"speaker":"직원","text":"며칠 묵으세요?","translation":"Anh ở mấy đêm ạ?","pronunciation":"Myeochil mugeuseyo?"},{"speaker":"남","text":"이틀이요. 얼마예요?","translation":"Hai đêm. Bao nhiêu ạ?","pronunciation":"Iteuriyo. Eolmayeyo?"},{"speaker":"직원","text":"하루에 십만 원이에요.","translation":"Một đêm một trăm nghìn won.","pronunciation":"Harue simman wonieyo."}],"vocabulary":[{"word":"빈 방","meaning":"Phòng trống","pronunciation":"Bin bang"},{"word":"묵다","meaning":"Ở trọ, lưu lại","pronunciation":"Mukda"},{"word":"하루","meaning":"Một ngày/đêm","pronunciation":"Haru"},{"word":"묻다","meaning":"Hỏi","pronunciation":"Mutda"}]},{"id":"dialogue-027","language":"korean","order":27,"title":"관광 안내","titleVi":"Hỏi du lịch","category":"여행과 호텔","context":"Hỏi điểm tham quan","lines":[{"speaker":"남","text":"이 근처에 볼 곳이 있어요?","translation":"Gần đây có chỗ nào tham quan không?","pronunciation":"I geuncheoe bol gosi isseoyo?"},{"speaker":"직원","text":"경복궁이 유명해요.","translation":"Cung Gyeongbok nổi tiếng ạ.","pronunciation":"Gyeongbokgungi yumyeonghaeyo."},{"speaker":"남","text":"어떻게 가요?","translation":"Đi thế nào ạ?","pronunciation":"Eotteoke gayo?"},{"speaker":"직원","text":"지하철로 십 분이에요.","translation":"Đi tàu điện mười phút.","pronunciation":"Jihacheollo sip bunieyo."}],"vocabulary":[{"word":"근처","meaning":"Gần đây","pronunciation":"Geuncheo"},{"word":"곳","meaning":"Nơi, chỗ","pronunciation":"Got"},{"word":"경복궁","meaning":"Cung Gyeongbok","pronunciation":"Gyeongbokgung"},{"word":"관광","meaning":"Tham quan","pronunciation":"Gwangwang"}]},{"id":"dialogue-028","language":"korean","order":28,"title":"체크아웃","titleVi":"Trả phòng","category":"여행과 호텔","context":"Trả phòng khách sạn","lines":[{"speaker":"남","text":"체크아웃할게요.","translation":"Tôi trả phòng.","pronunciation":"Chekeuauthalgeyo."},{"speaker":"직원","text":"방은 어떠셨어요?","translation":"Phòng thế nào ạ?","pronunciation":"Bangeun eotteosyeosseoyo?"},{"speaker":"남","text":"아주 좋았어요.","translation":"Rất tốt.","pronunciation":"Aju joasseoyo."},{"speaker":"직원","text":"감사합니다. 안녕히 가세요.","translation":"Cảm ơn. Chúc anh đi may mắn.","pronunciation":"Gamsahamnida. Annyeonghi gaseyo."}],"vocabulary":[{"word":"체크아웃","meaning":"Trả phòng","pronunciation":"Chekeuaut"},{"word":"방","meaning":"Phòng","pronunciation":"Bang"},{"word":"어떻다","meaning":"Thế nào","pronunciation":"Eotteota"},{"word":"좋다","meaning":"Tốt","pronunciation":"Jota"}]},{"id":"dialogue-029","language":"korean","order":29,"title":"수업 시간","titleVi":"Giờ học","category":"학교와 교육","context":"Hỏi về lớp học","lines":[{"speaker":"남","text":"한국어 수업이 몇 시예요?","translation":"Lớp tiếng Hàn mấy giờ ạ?","pronunciation":"Hangugeo sueobi myeot siyeyo?"},{"speaker":"친구","text":"오전 아홉 시예요.","translation":"Chín giờ sáng.","pronunciation":"Ojeon ahop siyeyo."},{"speaker":"남","text":"어디에서 해요?","translation":"Học ở đâu?","pronunciation":"Eodieseo haeyo?"},{"speaker":"친구","text":"이 층 교실에서 해요.","translation":"Ở phòng học tầng hai.","pronunciation":"I cheung gyosireseo haeyo."}],"vocabulary":[{"word":"수업","meaning":"Tiết học","pronunciation":"Sueop"},{"word":"교실","meaning":"Phòng học","pronunciation":"Gyosil"},{"word":"층","meaning":"Tầng","pronunciation":"Cheung"},{"word":"오전","meaning":"Buổi sáng","pronunciation":"Ojeon"}]},{"id":"dialogue-030","language":"korean","order":30,"title":"숙제","titleVi":"Bài tập về nhà","category":"학교와 교육","context":"Hỏi bài tập","lines":[{"speaker":"남","text":"오늘 숙제가 있어요?","translation":"Hôm nay có bài tập không?","pronunciation":"Oneul sukjega isseoyo?"},{"speaker":"친구","text":"네, 삼십 쪽까지 읽어야 해요.","translation":"Có, phải đọc đến trang ba mươi.","pronunciation":"Ne, samsip jjokkkaji ilgeoya haeyo."},{"speaker":"남","text":"언제까지예요?","translation":"Đến khi nào ạ?","pronunciation":"Eonjekkajiyeyo?"},{"speaker":"친구","text":"내일까지요.","translation":"Đến ngày mai.","pronunciation":"Naeilkkajiyo."}],"vocabulary":[{"word":"숙제","meaning":"Bài tập về nhà","pronunciation":"Sukje"},{"word":"쪽","meaning":"Trang","pronunciation":"Jjok"},{"word":"읽다","meaning":"Đọc","pronunciation":"Ikda"},{"word":"언제","meaning":"Khi nào","pronunciation":"Eonje"}]},{"id":"dialogue-031","language":"korean","order":31,"title":"시험 이야기","titleVi":"Nói về thi cử","category":"학교와 교육","context":"Trước kỳ thi","lines":[{"speaker":"남","text":"내일 시험이 어려워요?","translation":"Bài thi mai có khó không?","pronunciation":"Naeil siheomi eoryeowoyo?"},{"speaker":"친구","text":"조금 어려워요. 공부 많이 했어요?","translation":"Hơi khó. Bạn học nhiều chưa?","pronunciation":"Jogeum eoryeowoyo. Gongbu mani haesseoyo?"},{"speaker":"남","text":"어제 밤늦게까지 했어요.","translation":"Hôm qua tôi học đến khuya.","pronunciation":"Eoje bamneutgekkaji haesseoyo."},{"speaker":"친구","text":"잘할 거예요.","translation":"Bạn sẽ làm tốt thôi.","pronunciation":"Jalhal geoyeyo."}],"vocabulary":[{"word":"시험","meaning":"Kỳ thi","pronunciation":"Siheom"},{"word":"어렵다","meaning":"Khó","pronunciation":"Eoryeopda"},{"word":"공부","meaning":"Việc học","pronunciation":"Gongbu"},{"word":"밤늦게","meaning":"Đến khuya","pronunciation":"Bamneutge"}]},{"id":"dialogue-032","language":"korean","order":32,"title":"도서관에서","titleVi":"Ở thư viện","category":"학교와 교육","context":"Mượn sách thư viện","lines":[{"speaker":"남","text":"이 책 빌릴 수 있어요?","translation":"Tôi mượn cuốn sách này được không?","pronunciation":"I chaek billil su isseoyo?"},{"speaker":"사서","text":"학생증 있어요?","translation":"Anh có thẻ sinh viên không?","pronunciation":"Haksaengjeung isseoyo?"},{"speaker":"남","text":"네, 여기요.","translation":"Có, đây ạ.","pronunciation":"Ne, yeogiyo."},{"speaker":"사서","text":"이 주 동안 빌릴 수 있어요.","translation":"Anh mượn được hai tuần.","pronunciation":"I ju dongan billil su isseoyo."}],"vocabulary":[{"word":"도서관","meaning":"Thư viện","pronunciation":"Doseogwan"},{"word":"빌리다","meaning":"Mượn","pronunciation":"Billida"},{"word":"학생증","meaning":"Thẻ sinh viên","pronunciation":"Haksaengjeung"},{"word":"사서","meaning":"Thủ thư","pronunciation":"Saseo"}]},{"id":"dialogue-033","language":"korean","order":33,"title":"영화 보러 가기","titleVi":"Đi xem phim","category":"사교와 여가","context":"Rủ đi xem phim","lines":[{"speaker":"지민","text":"주말에 영화 볼래요?","translation":"Cuối tuần đi xem phim không?","pronunciation":"Jumare yeonghwa bollaeyo?"},{"speaker":"남","text":"좋아요. 무슨 영화요?","translation":"Được đấy. Phim gì?","pronunciation":"Joayo. Museun yeonghwayo?"},{"speaker":"지민","text":"요즘 인기 있는 거요.","translation":"Phim đang nổi dạo này.","pronunciation":"Yojeum ingi inneun geoyo."},{"speaker":"남","text":"그래요, 토요일에 봐요.","translation":"Vậy nhé, thứ Bảy đi xem.","pronunciation":"Geuraeyo, toyoire bwayo."}],"vocabulary":[{"word":"주말","meaning":"Cuối tuần","pronunciation":"Jumal"},{"word":"영화","meaning":"Phim","pronunciation":"Yeonghwa"},{"word":"인기","meaning":"Sự nổi tiếng","pronunciation":"Ingi"},{"word":"요즘","meaning":"Dạo này","pronunciation":"Yojeum"}]},{"id":"dialogue-034","language":"korean","order":34,"title":"생일 파티","titleVi":"Tiệc sinh nhật","category":"사교와 여가","context":"Mời dự sinh nhật","lines":[{"speaker":"지민","text":"이번 주 토요일이 제 생일이에요.","translation":"Thứ Bảy này là sinh nhật tôi.","pronunciation":"Ibeon ju toyoiri je saengirieyo."},{"speaker":"남","text":"와, 축하해요!","translation":"Ồ, chúc mừng!","pronunciation":"Wa, chukahaeyo!"},{"speaker":"지민","text":"파티에 올래요?","translation":"Đến dự tiệc nhé?","pronunciation":"Patie ollaeyo?"},{"speaker":"남","text":"물론이죠. 갈게요.","translation":"Tất nhiên rồi. Tôi sẽ đến.","pronunciation":"Mullonijyo. Galgeyo."}],"vocabulary":[{"word":"생일","meaning":"Sinh nhật","pronunciation":"Saengil"},{"word":"축하하다","meaning":"Chúc mừng","pronunciation":"Chukahada"},{"word":"파티","meaning":"Tiệc","pronunciation":"Pati"},{"word":"물론","meaning":"Tất nhiên","pronunciation":"Mullon"}]},{"id":"dialogue-035","language":"korean","order":35,"title":"운동하기","titleVi":"Tập thể thao","category":"사교와 여가","context":"Rủ tập thể thao","lines":[{"speaker":"남","text":"같이 운동할래요?","translation":"Cùng tập thể thao không?","pronunciation":"Gachi undonghallaeyo?"},{"speaker":"지민","text":"무슨 운동요?","translation":"Môn gì?","pronunciation":"Museun undongyo?"},{"speaker":"남","text":"축구 어때요?","translation":"Đá bóng thế nào?","pronunciation":"Chukgu eottaeyo?"},{"speaker":"지민","text":"좋아요. 공원에서 만나요.","translation":"Được. Gặp ở công viên nhé.","pronunciation":"Joayo. Gongwoneseo mannayo."}],"vocabulary":[{"word":"운동","meaning":"Thể thao","pronunciation":"Undong"},{"word":"축구","meaning":"Bóng đá","pronunciation":"Chukgu"},{"word":"공원","meaning":"Công viên","pronunciation":"Gongwon"},{"word":"같이","meaning":"Cùng nhau","pronunciation":"Gachi"}]},{"id":"dialogue-036","language":"korean","order":36,"title":"커피 약속","titleVi":"Hẹn cà phê","category":"사교와 여가","context":"Rủ uống cà phê","lines":[{"speaker":"지민","text":"시간 있으면 커피 한잔해요.","translation":"Có rảnh thì đi cà phê nhé.","pronunciation":"Sigan isseumyeon keopi hanjanhaeyo."},{"speaker":"남","text":"좋아요. 언제요?","translation":"Được. Khi nào?","pronunciation":"Joayo. Eonjeyo?"},{"speaker":"지민","text":"내일 오후 어때요?","translation":"Chiều mai thế nào?","pronunciation":"Naeil ohu eottaeyo?"},{"speaker":"남","text":"네, 그때 봐요.","translation":"Vâng, lúc đó gặp nhé.","pronunciation":"Ne, geuttae bwayo."}],"vocabulary":[{"word":"시간","meaning":"Thời gian","pronunciation":"Sigan"},{"word":"커피","meaning":"Cà phê","pronunciation":"Keopi"},{"word":"한잔하다","meaning":"Làm một ly","pronunciation":"Hanjanhada"},{"word":"그때","meaning":"Lúc đó","pronunciation":"Geuttae"}]},{"id":"dialogue-037","language":"korean","order":37,"title":"길을 잃었어요","titleVi":"Bị lạc đường","category":"긴급 상황","context":"Hỏi khi lạc","lines":[{"speaker":"남","text":"죄송해요, 길을 잃었어요.","translation":"Xin lỗi, tôi bị lạc đường.","pronunciation":"Joesonghaeyo, gireul ileosseoyo."},{"speaker":"행인","text":"어디 가세요?","translation":"Anh đi đâu ạ?","pronunciation":"Eodi gaseyo?"},{"speaker":"남","text":"시청에 가고 싶어요.","translation":"Tôi muốn đến toà thị chính.","pronunciation":"Sicheonge gago sipeoyo."},{"speaker":"행인","text":"저기 지하철을 타세요.","translation":"Anh đi tàu điện đằng kia.","pronunciation":"Jeogi jihacheoreul taseyo."}],"vocabulary":[{"word":"죄송하다","meaning":"Xin lỗi","pronunciation":"Joesonghada"},{"word":"길을 잃다","meaning":"Lạc đường","pronunciation":"Gireul ilta"},{"word":"시청","meaning":"Toà thị chính","pronunciation":"Sicheong"},{"word":"저기","meaning":"Đằng kia","pronunciation":"Jeogi"}]},{"id":"dialogue-038","language":"korean","order":38,"title":"지갑을 잃어버렸어요","titleVi":"Mất ví","category":"긴급 상황","context":"Báo mất ví","lines":[{"speaker":"남","text":"지갑을 잃어버렸어요.","translation":"Tôi bị mất ví.","pronunciation":"Jigabeul ileobeoryeosseoyo."},{"speaker":"경찰","text":"어디에서 잃어버렸어요?","translation":"Anh mất ở đâu?","pronunciation":"Eodieseo ileobeoryeosseoyo?"},{"speaker":"남","text":"지하철에서요.","translation":"Trên tàu điện.","pronunciation":"Jihacheoreseoyo."},{"speaker":"경찰","text":"여기 신고서를 쓰세요.","translation":"Anh viết đơn trình báo ở đây.","pronunciation":"Yeogi singoseoreul sseuseyo."}],"vocabulary":[{"word":"지갑","meaning":"Cái ví","pronunciation":"Jigap"},{"word":"잃어버리다","meaning":"Đánh mất","pronunciation":"Ileobeorida"},{"word":"경찰","meaning":"Cảnh sát","pronunciation":"Gyeongchal"},{"word":"신고서","meaning":"Đơn trình báo","pronunciation":"Singoseo"}]},{"id":"dialogue-039","language":"korean","order":39,"title":"도와주세요","titleVi":"Xin giúp đỡ","category":"긴급 상황","context":"Gọi giúp khi có người ngã","lines":[{"speaker":"남","text":"도와주세요! 사람이 쓰러졌어요.","translation":"Cứu với! Có người ngã.","pronunciation":"Dowajuseyo! Sarami sseureojyeosseoyo."},{"speaker":"행인","text":"괜찮으세요? 구급차 부를게요.","translation":"Anh ổn chứ? Tôi gọi xe cứu thương.","pronunciation":"Gwaenchaneuseyo? Gugeupcha bureulgeyo."},{"speaker":"남","text":"빨리요!","translation":"Nhanh lên!","pronunciation":"Ppalliyo!"},{"speaker":"행인","text":"금방 올 거예요.","translation":"Xe sắp đến rồi.","pronunciation":"Geumbang ol geoyeyo."}],"vocabulary":[{"word":"도와주다","meaning":"Giúp đỡ","pronunciation":"Dowajuda"},{"word":"쓰러지다","meaning":"Ngã, gục","pronunciation":"Sseureojida"},{"word":"구급차","meaning":"Xe cứu thương","pronunciation":"Gugeupcha"},{"word":"빨리","meaning":"Nhanh","pronunciation":"Ppalli"}]},{"id":"dialogue-040","language":"korean","order":40,"title":"불이 났어요","titleVi":"Cháy rồi","category":"긴급 상황","context":"Báo cháy","lines":[{"speaker":"남","text":"불이 났어요! 어떻게 해요?","translation":"Cháy rồi! Làm sao đây?","pronunciation":"Buri nasseoyo! Eotteoke haeyo?"},{"speaker":"직원","text":"침착하세요. 밖으로 나가세요.","translation":"Bình tĩnh. Anh ra ngoài đi.","pronunciation":"Chimchakaseyo. Bakkeuro nagaseyo."},{"speaker":"남","text":"소방서에 전화했어요?","translation":"Đã gọi cứu hoả chưa?","pronunciation":"Sobangseoe jeonhwahaesseoyo?"},{"speaker":"직원","text":"네, 곧 올 거예요.","translation":"Rồi, sắp đến rồi.","pronunciation":"Ne, got ol geoyeyo."}],"vocabulary":[{"word":"불이 나다","meaning":"Cháy","pronunciation":"Buri nada"},{"word":"침착하다","meaning":"Bình tĩnh","pronunciation":"Chimchakada"},{"word":"밖","meaning":"Bên ngoài","pronunciation":"Bak"},{"word":"소방서","meaning":"Sở cứu hoả","pronunciation":"Sobangseo"}]}]